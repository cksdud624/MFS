/* 모리 트레이딩 — 웹 버전 패널(cs/panel-style.js) 이식.
 * 색·간격·모서리는 웹과 같게. USS 에 없는 것(그라데이션·box-shadow·grid·gap)은 단색·테두리·flex·margin 으로 바꿨다.
 * 대비(WCAG): 웹에서 4.5:1 미만이던 두 곳만 고침 — 입력칸 안 회색 글자 #848e9c→#9aa4b2(3.95→5.2), 카드 위 빨간 글자 #f6465d→#ff6b81(4.48→5.78).
 */
:root {
    --page: #0b0e11;
    --panel: #181a20;
    --hd: #1e2329;
    --field: #2b3139;
    --line: #2b3139;
    --dark: #12151a;
    --text: #eaecef;
    --text2: #b7bdc6;
    --muted: #848e9c;
    --muted2: #9aa4b2;
    --up: #0ecb81;
    --dn: #f6465d;
    --dn-text: #ff6b81;
    --gold: #f0b90b;
    --gold2: #fcd535;
    --glow: #ffe14d;
}

.mt-root { flex-grow: 1; flex-direction: row; background-color: var(--page); color: var(--text); font-size: 12px; }
.hide { display: none; }
.up, .pos { color: var(--up); }
.dn, .neg { color: var(--dn-text); }
.muted { color: var(--muted); }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }

/* ── 왼쪽: 시장 막대 + 차트 ── */
.mt-left { flex-grow: 1; flex-direction: column; }
.mt-mbar { flex-direction: row; align-items: center; min-height: 50px; padding: 4px 14px; background-color: var(--panel); border-bottom-width: 1px; border-color: var(--line); }
.mt-brand { font-size: 15px; -unity-font-style: bold; color: var(--gold); margin-right: 20px; white-space: nowrap; flex-shrink: 0; }
.mt-symtab { flex-direction: column; justify-content: center; padding: 4px 12px; margin-right: 4px; flex-shrink: 0; border-radius: 4px; border-bottom-width: 2px; border-color: rgba(0,0,0,0); }
.mt-symtab:hover { background-color: var(--hd); }
.mt-symtab--on { border-color: var(--gold); background-color: var(--hd); }
.mt-symtab__n { font-size: 12px; -unity-font-style: bold; color: var(--text); white-space: nowrap; margin: 0 0 2px 0; padding: 0; }
.mt-symtab__p { font-size: 11px; white-space: nowrap; margin: 0; padding: 0; }
.mt-clock { color: var(--muted2); margin-left: 12px; white-space: nowrap; }
.mt-mkt { padding: 2px 10px; border-radius: 10px; font-size: 11px; -unity-font-style: bold; margin-left: 10px; white-space: nowrap; flex-shrink: 0; }
.mt-mkt--open { background-color: var(--up); color: #06231a; }
.mt-mkt--closed { background-color: #474d57; color: #ffffff; }
.mt-tbar { flex-direction: row; align-items: center; min-height: 38px; padding: 4px 12px; background-color: var(--page); border-bottom-width: 1px; border-color: var(--line); }

.mini {
    min-height: 26px; min-width: 26px; padding: 0 10px; margin: 0 0 0 6px;
    border-width: 0; border-radius: 4px; background-color: #363c45; color: var(--text); font-size: 12px;
}
.mini:hover { background-color: #424954; }
.mini--on { background-color: var(--gold); color: var(--panel); -unity-font-style: bold; }
.mini--danger { background-color: #c42f45; color: #ffffff; }
.mini:disabled { opacity: 0.4; }
.ghost { background-color: rgba(0,0,0,0); color: var(--muted2); }
.ghost:hover { color: var(--text); background-color: var(--hd); }
.ghost.mini--on { background-color: var(--hd); color: var(--gold); }

/* 차트 */
.mori-chart { flex-grow: 1; background-color: var(--page); overflow: hidden; }
.mori-axis-label { position: absolute; font-size: 11px; color: var(--muted); }
.mori-tag { position: absolute; font-size: 11px; padding: 1px 4px; border-radius: 2px; color: #0b0e11; -unity-font-style: bold; }
.mori-tag--cross { background-color: #474d57; color: #ffffff; -unity-font-style: normal; }
.mori-chart-ohlc { position: absolute; left: 12px; top: 8px; font-size: 12px; color: var(--muted); }
.mori-chart-ma { position: absolute; left: 12px; top: 28px; font-size: 11px; }

/* ── 오른쪽 패널(.p) ── */
.p { width: 372px; margin: 10px; flex-direction: column; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 10px; overflow: hidden; }
.hd { flex-direction: row; align-items: center; padding: 10px 12px; background-color: var(--hd); }
.sym { flex-direction: column; flex-shrink: 1; }
.sym-name { font-size: 14px; -unity-font-style: bold; color: var(--text); }
.tag { font-size: 11px; color: var(--gold); border-width: 1px; border-color: rgba(240,185,11,0.35); border-radius: 4px; padding: 1px 6px; margin-top: 4px; align-self: flex-start; }
.px { flex-grow: 1; -unity-text-align: middle-right; font-size: 16px; -unity-font-style: bold; color: var(--text); margin: 0 8px 0 10px; white-space: nowrap; }
.px.up { color: var(--up); }
.px.dn { color: var(--dn); }
.hb { flex-direction: row; }
.hb-btn { background-color: rgba(0,0,0,0); border-width: 0; color: var(--muted2); font-size: 14px; min-width: 30px; min-height: 30px; padding: 0 5px; margin: 0 0 0 2px; }
.hb-btn:hover { color: var(--text); background-color: var(--field); }
.hb-btn--alert { color: var(--gold); }
.hb-btn--danger { color: var(--dn-text); }

.acrow { flex-direction: row; align-items: center; padding: 5px 12px; background-color: var(--dark); border-top-width: 1px; border-color: var(--line); color: var(--muted2); }
.acrow-sel { flex-grow: 1; margin: 0 0 0 8px; }
.fundbar { flex-direction: row; justify-content: space-between; padding: 4px 12px; background-color: var(--dark); border-top-width: 1px; border-color: var(--line); color: var(--muted); }
.fundbar-v { -unity-font-style: bold; color: var(--text); }

.lv { flex-direction: row; align-items: center; flex-wrap: wrap; padding: 6px 12px; background-color: var(--hd); border-top-width: 1px; border-color: var(--line); color: var(--text2); }
.lv-txt { color: var(--text2); margin-right: 8px; }
.bar { flex-grow: 1; height: 5px; min-width: 40px; background-color: var(--field); border-radius: 3px; overflow: hidden; margin-right: 8px; }
.bar-fill { height: 100%; width: 0; background-color: var(--gold); transition-property: width; transition-duration: 0.4s; }
.lv-xp { color: var(--text2); margin-right: 8px; }
.chip { padding: 2px 8px; border-radius: 10px; background-color: var(--field); color: #ffffff; -unity-font-style: bold; margin-right: 6px; }
.chip--fire { background-color: #5a2308; color: #ffb347; }
.chip--pop { scale: 1.3 1.3; }
.chip { transition-property: scale; transition-duration: 0.3s; }
.mascot { font-size: 17px; transition-property: translate, scale; transition-duration: 0.25s; }
.mascot--hop { translate: 0 -7px; scale: 1.2 1.2; }
.mbub {
    position: absolute; right: 8px; top: 120px; max-width: 210px; padding: 5px 8px; border-radius: 8px;
    background-color: var(--text); color: #14181d; -unity-font-style: bold; font-size: 12px; white-space: normal;
    opacity: 0; translate: 0 -4px; transition-property: opacity, translate; transition-duration: 0.25s;
}
.mbub--on { opacity: 1; translate: 0 0; }

.body { flex-grow: 1; }
.acct { flex-direction: row; padding: 10px 12px; border-bottom-width: 1px; border-color: var(--line); }
.acct-c { flex-grow: 1; flex-basis: 0; flex-direction: column; color: var(--muted); }
.acct-v { color: var(--text); font-size: 12px; -unity-font-style: bold; }
.rk { flex-direction: row; align-items: center; padding: 5px 12px; background-color: var(--dark); border-bottom-width: 1px; border-color: var(--line); color: var(--text2); }
.rk-lv { -unity-font-style: bold; margin-right: 8px; }
.rk-lv--safe { color: #2ee6a6; }
.rk-lv--caution { color: #ffe14d; }
.rk-lv--danger { color: #ff6b81; }
.rk-g { width: 70px; height: 6px; border-radius: 3px; background-color: var(--field); overflow: hidden; margin-right: 8px; }
.rk-gi { height: 100%; width: 0; border-radius: 3px; transition-property: width, background-color; transition-duration: 0.4s; }

.tabs { flex-direction: row; border-bottom-width: 1px; border-color: var(--line); }
.tab { flex-grow: 1; flex-basis: 0; background-color: rgba(0,0,0,0); border-width: 0; border-bottom-width: 2px; border-color: rgba(0,0,0,0); border-radius: 0; color: var(--muted); padding: 10px 2px; margin: 0; font-size: 12px; }
.tab:hover { color: var(--text); }
.tab--on { color: var(--gold); border-color: var(--gold); }
.view { padding: 12px 14px; }

/* 거래 폼 */
.row2 { flex-direction: row; align-items: center; margin: 0 -4px 10px -4px; }
.pill { flex-grow: 1; flex-basis: 0; background-color: var(--field); color: var(--text); border-width: 0; border-radius: 5px; padding: 6px; min-height: 30px; margin: 0 4px; font-size: 13px; -unity-font-style: bold; }
.pill:hover { background-color: #363c45; }
.oc { flex-direction: row; background-color: var(--field); border-radius: 7px; padding: 3px; margin-bottom: 12px; }
.oc-b { flex-grow: 1; flex-basis: 0; background-color: rgba(0,0,0,0); border-width: 0; color: var(--text2); padding: 7px; border-radius: 5px; margin: 0; font-size: 13px; }
.oc-b:hover { color: var(--text); }
.oc-b--on { background-color: var(--gold2); color: var(--panel); -unity-font-style: bold; }
.ut { flex-direction: row; margin-bottom: 12px; }
.ut-b { background-color: rgba(0,0,0,0); border-width: 0; border-bottom-width: 2px; border-color: rgba(0,0,0,0); border-radius: 0; color: var(--muted); padding: 4px 0 6px 0; margin: 0 16px 0 0; font-size: 13px; }
.ut-b--on { color: var(--text); border-color: var(--gold); -unity-font-style: bold; }
.avbl { flex-direction: row; justify-content: space-between; color: var(--muted); margin-bottom: 10px; }
.avbl-v { color: var(--text); }
.sel { margin: 0 0 8px 0; }

.f { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 8px; background-color: var(--field); border-radius: 5px; padding: 0 10px; min-height: 36px; }
.f-l { color: var(--muted2); min-width: 52px; font-size: 12px; margin-right: 6px; white-space: nowrap; }
.f-u { color: var(--muted2); font-size: 12px; margin-left: 6px; white-space: nowrap; }
.f-in { flex-grow: 1; margin: 0; min-width: 60px; }
.f-in .unity-base-text-field__input, .f-in .unity-text-field__input {
    background-color: rgba(0,0,0,0); border-width: 0; color: var(--text); -unity-text-align: middle-right; padding: 6px 2px; font-size: 13px;
    --unity-cursor-color: var(--text); --unity-selection-color: rgba(240,185,11,0.35);
}

.f--price .f-in .unity-base-text-field__input { background-color: var(--hd); border-width: 1px; border-color: #474d57; border-radius: 4px; padding: 6px 8px; font-size: 15px; -unity-font-style: bold; }

.slider { margin: 4px 0 0 0; }
.slider .unity-base-slider__tracker { background-color: var(--field); border-width: 0; height: 4px; margin-top: -2px; }
.slider .unity-base-slider__dragger { background-color: var(--gold); border-width: 0; border-radius: 7px; width: 14px; height: 14px; margin-top: -7px; }
.slider .unity-base-slider__dragger-border { display: none; }
.ticks { flex-direction: row; justify-content: space-between; color: var(--muted); margin: 2px 0 8px 0; }

.chk { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 8px 0; color: var(--text2); }
.chk-t { margin: 0 14px 4px 0; }
.chk-t .unity-toggle__checkmark { background-color: var(--field); border-color: #474d57; width: 14px; height: 14px; }
.chk-t:checked .unity-toggle__checkmark { background-color: var(--gold); border-color: var(--gold); -unity-background-image-tint-color: var(--panel); }
.chk-t .unity-toggle__text, .chk-t .unity-label { color: var(--text2); margin-left: 4px; }
.est { color: var(--muted); padding: 0 2px 6px 2px; white-space: normal; }
.rkbox { padding: 2px 2px 6px 2px; }
.rkmsg { color: var(--text2); padding: 0 2px 4px 2px; white-space: normal; }

.info { background-color: var(--hd); border-radius: 7px; padding: 8px 12px; margin: 10px 0; color: var(--muted); }
.info-r { flex-direction: row; justify-content: space-between; padding: 2px 0; }
.info-v { color: var(--text); }
.btns { flex-direction: row; margin: 0 -4px; }
.btn-buy, .btn-sell, .btn-redb, .btn-greenb {
    flex-grow: 1; flex-basis: 0; border-width: 0; border-radius: 6px; padding: 11px 6px; margin: 0 4px; -unity-font-style: bold; font-size: 13px;
}
.btn-buy, .btn-greenb { background-color: var(--up); color: #06231a; }
.btn-sell, .btn-redb { background-color: #d92e47; color: #ffffff; }
.btn-buy:hover, .btn-greenb:hover { background-color: #2bd896; }
.btn-sell:hover, .btn-redb:hover { background-color: #b8263c; }
.btn-buy:disabled, .btn-sell:disabled, .btn-redb:disabled, .btn-greenb:disabled { opacity: 0.4; }
.msg { min-height: 16px; margin-top: 8px; color: var(--dn-text); white-space: normal; }
.msg--ok { color: var(--up); }
.hint { color: var(--muted); margin-top: 8px; white-space: normal; }

/* 포지션 카드 */
.flat { flex-direction: row; margin: 0 -4px 10px -4px; }
.flat-b { flex-grow: 1; flex-basis: 0; padding: 8px 10px; border-radius: 6px; border-width: 1px; border-color: #474d57; -unity-font-style: bold; background-color: var(--field); color: var(--text); margin: 0 4px; }
.flat-b--red { background-color: #d92e47; color: #ffffff; border-color: #d92e47; }
.flat-b:disabled { opacity: 0.4; }
.card { background-color: var(--hd); border-width: 1px; border-color: var(--line); border-radius: 9px; padding: 10px 12px; margin-bottom: 10px; }
.card--warn { border-color: var(--dn); }
.ch { flex-direction: row; align-items: center; margin-bottom: 6px; }
.ch-sym { font-size: 13px; -unity-font-style: bold; margin-right: 8px; white-space: nowrap; }
.badge { padding: 1px 7px; border-radius: 4px; margin-right: 6px; white-space: nowrap; flex-shrink: 0; color: #ffffff; }
.badge--long { background-color: var(--up); color: #06231a; }
.badge--short { background-color: #d92e47; color: #ffffff; }
.badge--gray { background-color: #474d57; color: #ffffff; }
.warnT { color: var(--dn-text); }
.pnl { font-size: 15px; -unity-font-style: bold; }
.grid { flex-direction: row; flex-wrap: wrap; margin: 8px 0; }
.grid-c { width: 33.3%; flex-direction: column; color: var(--muted); margin-bottom: 6px; padding-right: 6px; }
.grid-v { color: var(--text); }
.acts { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.act { background-color: var(--field); border-width: 0; color: var(--text); border-radius: 5px; padding: 6px 10px; margin: 0 6px 6px 0; font-size: 12px; }
.act:hover { background-color: #363c45; }
.act--red { background-color: #d6334a; color: #ffffff; -unity-font-style: bold; }
.act--red:hover { background-color: #e04058; }
.tpchip { flex-direction: row; align-items: center; padding: 2px 8px; border-radius: 10px; background-color: var(--field); margin: 0 6px 4px 0; }
.tpchip-x { background-color: rgba(0,0,0,0); border-width: 0; color: var(--muted2); padding: 0 0 0 4px; margin: 0; }

.sub { flex-direction: row; justify-content: space-between; align-items: center; color: var(--muted); margin: 8px 0 6px 0; }
.tr { flex-direction: row; align-items: center; padding: 6px 2px; border-bottom-width: 1px; border-color: var(--line); }
.td { flex-grow: 1; flex-basis: 0; white-space: normal; padding: 0 3px; }
.td--r { -unity-text-align: middle-right; }
.small { color: var(--muted); font-size: 11px; }
.seg { flex-direction: row; margin: 0 -3px 10px -3px; }
.seg-b { flex-grow: 1; flex-basis: 0; background-color: rgba(0,0,0,0); border-width: 0; color: var(--muted); padding: 6px; border-radius: 5px; margin: 0 3px; }
.seg-b--on { background-color: var(--field); color: var(--gold); -unity-font-style: bold; }

/* 성과 */
.tiles { flex-direction: row; flex-wrap: wrap; margin-bottom: 10px; }
.tile { width: 32%; margin: 0 1.3% 8px 0; background-color: var(--hd); border-radius: 7px; padding: 8px 9px; }
.tile-k { color: var(--muted); }
.tile-v { font-size: 13px; -unity-font-style: bold; color: var(--text); }
.hours { flex-direction: row; align-items: flex-end; height: 38px; margin: 4px 0; }
.hours-i { flex-grow: 1; flex-basis: 0; margin: 0 0.5px; min-height: 1px; background-color: #474d57; }
.dow { flex-direction: row; justify-content: space-around; color: var(--muted); }
.tip { border-left-width: 3px; border-color: #474d57; background-color: var(--hd); border-radius: 5px; padding: 8px 10px; margin-bottom: 8px; white-space: normal; }
.tip--warn { border-color: var(--gold); }
.tip--good { border-color: var(--up); }
.tip--info { border-color: #5b8def; }
.curve { height: 70px; margin: 4px 0 8px 0; }

/* 업적 */
.bigl { background-color: #2b2410; border-width: 1px; border-color: rgba(240,185,11,0.35); border-radius: 9px; padding: 12px 14px; margin-bottom: 10px; align-items: center; }
.bigl-i { font-size: 30px; }
.bigl-h { font-size: 16px; -unity-font-style: bold; color: var(--glow); }
.bigl .bar { width: 100%; flex-grow: 0; margin: 6px 0; }
.ach { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.a { width: 48.6%; margin: 0 0 8px 0; background-color: var(--hd); border-width: 1px; border-color: var(--line); border-radius: 7px; padding: 8px 10px; opacity: 0.75; }
.a--on { opacity: 1; background-color: #3a2f06; border-color: rgba(255,225,77,0.6); }
.a-n { -unity-font-style: bold; color: var(--text); white-space: normal; }
.a--on .a-n { color: var(--glow); }
.a-d { color: var(--muted2); white-space: normal; }
.a--on .a-d { color: #ffec99; }
.a-x { color: var(--gold); }

/* 레버리지 창 */
.modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.7); align-items: center; justify-content: center; }
.mbox { background-color: var(--hd); border-width: 1px; border-color: var(--line); border-radius: 10px; padding: 16px 18px; width: 320px; }
.mbox-h { font-size: 13px; -unity-font-style: bold; margin-bottom: 10px; }
.mbox-v { font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--gold); margin: 4px 0; }
.qk { flex-direction: row; flex-wrap: wrap; margin: 10px 0; }
.qk > * { margin: 0 6px 6px 0; }

/* 알림(토스트) — 패널 왼쪽에 쌓인다 */
.toasts { position: absolute; right: 396px; top: 60px; width: 340px; flex-direction: column; }
.t {
    color: #f5f7fa; -unity-font-style: bold; background-color: rgba(24,28,35,0.96);
    border-width: 1px; border-color: #3a4250; border-left-width: 4px; border-left-color: #5b8def; border-radius: 6px;
    padding: 10px 12px; margin-bottom: 8px; white-space: normal; text-shadow: 0 1px 2px rgba(0,0,0,0.6);
    opacity: 0; translate: 30px 0; transition-property: opacity, translate; transition-duration: 0.25s;
}
.t--in { opacity: 1; translate: 0 0; }
.t--win { border-left-color: var(--up); }
.t--loss, .t--danger { border-left-color: var(--dn); }
.t--ach, .t--level { color: var(--glow); background-color: #3a2f06; border-left-color: var(--glow); }
.t-sub { color: #c9d1dc; -unity-font-style: normal; margin-top: 3px; white-space: normal; text-shadow: 0 0 0 rgba(0,0,0,0); }
.t--ach .t-sub, .t--level .t-sub { color: #ffec99; }

.lvup {
    position: absolute; left: 0; right: 392px; top: 35%; -unity-text-align: middle-center;
    font-size: 40px; -unity-font-style: bold; color: var(--gold2); text-shadow: 0 0 12px #f0b90b;
    opacity: 0; scale: 0.6 0.6; transition-property: opacity, scale, translate; transition-duration: 0.4s, 0.4s, 2s;
}
.lvup--on { opacity: 1; scale: 1.1 1.1; translate: 0 -40px; }
.lvup--out { opacity: 0; translate: 0 -80px; }

/* 기본 테마의 드롭다운을 어두운 패널에 맞춤 */
.dd .unity-base-popup-field__input, .dd .unity-base-field__input { background-color: var(--field); border-color: #3b4350; color: var(--text); min-height: 26px; padding: 0 8px; border-radius: 5px; }
.dd .unity-base-popup-field__text, .dd .unity-text-element { color: var(--text); }
